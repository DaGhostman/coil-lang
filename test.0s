fn fib(int n) -> int {
    if n <= 2 {
        return 1;
    }

    return fib(n - 1) + fib(n - 2);
}

fn add(int x, int y) -> int {
    return x + y;
}

fn fizbuz(int n) {
    match n {
        case 3 => { print "fiz"; }
        case 5 => { print "buz"; }
        case 15 => { print "fizbuz"; }
    }
}

enum Colors {
    RGB(int, int, int),
    CMYK(float, float, float, float),
}

enum Color {
    Red,
    Green,
    Blue
}

fn print_color(Color c) -> void {
    match c {
        case Color::Red => { print "Red"; }
        case Color::Green => { print "Green"; }
        case Color::Blue => {
            print "Blue";
        }
    }

    print "Rust-style enum works!";
}

fn print_pallete(Colors c, int x) {
    match c {
        case Colors::RGB(r, g, b) => { print "rgb(%i, %i, %i)", r, g, b; }
        case Colors::CMYK(c, m, y, k) => { print "cmyk(%f, %f, %f, %f)", c, m, y, k; }
    }

    print "X is: %i", x;
}

fn main() {
    print "%i", fib(3);
    print "%i", add(10, add(20, 20));
    fizbuz(3);
    fizbuz(5);
    fizbuz(15);
    print_color(Color::Red);
    print_color(Color::Green);
    print_pallete(Colors::RGB(100, 500, 0));
}
