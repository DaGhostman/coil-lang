// Expected output: 01234012356
//
// Lazy int/byte ranges: half-open `a..b`, closed `a..=b`, first-class
// values, and byte bounds. Decreasing ranges are empty (Rust-like).

fn main() {
    // Half-open: 0..5 → 0,1,2,3,4
    for x in 0..5 {
        print "%i", x;
    }

    // First-class range value
    let r = 0..=3;
    for x in r {
        print "%i", x;
    }

    // Decreasing is empty — prints nothing
    for x in 10..0 {
        print "%i", x;
    }

    // Byte range: 5..=6 → 5,6
    let lo: byte = 5;
    let hi: byte = 6;
    for b in lo..=hi {
        print "%i", b;
    }
}
