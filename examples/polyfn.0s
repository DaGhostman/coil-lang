// Expected output: 424.04242

typeclass Describable<T> {
    fn describe_val(T x) -> int;
}

impl Describable<int> {
    fn describe_val(int x) -> int {
        return x + 1;
    }
}

fn id<T>(T x) -> T {
    return x;
}

fn show<T: Describable>(T x) -> int {
    return describe_val(x);
}

fn apply_id(forall T. T -> T f, int x) -> int {
    return f(x);
}

fn main() {
    let f = id;
    print "%i", f(42);
    print "%f", f(4.0);

    let constrained = show;
    print "%i", constrained(41);
    print "%i", apply_id(id, 42);
}
