// C calls back into zero-script via ffi::types::Callback. Expected output: `42`.

use ffi::*;
use ffi::types::*;

fn doubler(int x) -> int {
    return x * 2;
}

fn main() {
    let lib = dload("libsum.so");
    let id = declare(lib, "apply_cb", (Callback, Int), Int);
    print "%i", invoke(lib, id, (doubler, 21));
}
