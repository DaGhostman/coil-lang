// Client-side pure helpers for the echo demo.
// TCP connect/send/recv stays in `main.0s` (IO HostInvoke from a
// dependency module currently does not run correctly).

fn request_body() -> [byte] {
    let a: byte = 65;
    let b: byte = 66;
    let body: [byte] = [a];
    push(body, b);
    return body;
}

fn client_port() -> int {
    return 41235;
}
