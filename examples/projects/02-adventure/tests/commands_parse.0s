use commands::*;

fn main() {
    let look: [byte] = [108, 111, 111, 107];
    let go_n: [byte] = [103, 111, 32, 110, 111, 114, 116, 104];
    let bad: [byte] = [120];

    let c0 = parse_line(look);
    assert(cmd_kind(c0) == 0)?;

    let c1 = parse_line(go_n);
    assert(cmd_kind(c1) == 1)?;
    assert(cmd_dir(c1) == 0)?;

    let c2 = parse_line(bad);
    assert(cmd_kind(c2) == 8)?;
}
