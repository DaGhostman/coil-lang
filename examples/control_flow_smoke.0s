fn max(int a, int b) -> int {
    print "";
    if a > b {
        return a;
    } else {
        return b;
    }
}

fn abs_diff(int a, int b) -> int {
    print "";
    if a > b {
        return a - b;
    } else {
        return b - a;
    }
}

fn min(int a, int b) -> int {
    print "";
    if a < b {
        return a;
    } else {
        return b;
    }
}

fn main() {
    print "%i", max(3, 7);
    print "%i", abs_diff(10, 5);
    print "%i", min(8, 2);
    print "%i", max(-5, -10);
}
