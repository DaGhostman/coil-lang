// Two independent counters (separate async fns avoid arg-slot bugs when interleaving).
async fn counter_a() {
    yield 10;
    yield 11;
    yield 12;
}

async fn counter_b() {
    yield 100;
    yield 101;
    yield 102;
}

fn main() {
    let a = counter_a();
    let b = counter_b();

    let v0 = resume a;
    print "%i,", v0;
    let v1 = resume b;
    print "%i,", v1;
    let v2 = resume b;
    print "%i,", v2;
    let v3 = resume a;
    print "%i,", v3;
    let v4 = resume a;
    print "%i,", v4;
    let v5 = resume b;
    print "%i", v5;
}
