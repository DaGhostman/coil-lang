fn fib(int n) -> int {
    let i = 0;
    let a = 0;
    let b = 1;
    let c = 0;

    while i < (n - 1) {
        c = b;
        b = a + b;
        a = c;
        i++;
    }
    return b;
}

fn main() {
    print "%i", fib(32);
}

