// Expected output: 7424.0
//
// Userland generic functions with a Num typeclass bound.
// Builtin Num instances cover int, float, and string (+).

fn add<T: Num>(T a, T b) -> T {
    return a + b;
}

fn main() {
    print "%i", add(3, 4);
    print "%i", add(10, 32);
    print "%f", add(1.5, 2.5);
}
