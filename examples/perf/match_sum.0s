// CPU: enum construction + match dispatch in a loop.
enum Opt {
    None,
    Some(int),
}

fn payload(Opt o) -> int {
    return match o {
        Opt::None => 0,
        Opt::Some(x) => x,
    };
}

fn main() {
    let acc = 0;
    let i = 0;
    while (i < 2000) {
        acc = acc + payload(Opt::Some((i % 7) + 1));
        i = i + 1;
    }
    print "%i", acc;
}
