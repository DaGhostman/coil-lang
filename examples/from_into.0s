// Expected output: 4224
//
// Prelude From / Into: `impl From<A> for B` and `impl Into<B> for A`
// both enable A → B conversion. Extraction from the resulting enum uses
// an ordinary function (trait-dict methods currently mishandle heap
// receivers — a pre-existing limitation unrelated to these traits).

enum Wrapper {
    W(int),
}

impl From<int> for Wrapper {
    fn from(int x) -> Wrapper {
        return Wrapper::W(x);
    }
}

impl Into<Wrapper> for int {
    fn into(int x) -> Wrapper {
        return Wrapper::W(x + 1);
    }
}

fn wrap_from<A, B>(A x) -> B where From<B, A> {
    return from(x);
}

fn wrap_into<A, B>(A x) -> B where Into<A, B> {
    return into(x);
}

fn payload(Wrapper w) -> int {
    return match w {
        Wrapper::W(v) => v,
    };
}

fn main() {
    print "%i", payload(wrap_from(42));
    print "%i", payload(wrap_into(23));
}
