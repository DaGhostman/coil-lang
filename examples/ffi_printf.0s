// ffi_printf.0s — C-style varargs via bare `...` on an extern declaration.
// Calls libc `printf` with a format string and one int argument.
//
// Expected output: `hello 42`
//
// Language `int` maps to libffi `i64`, so use a 64-bit C conversion
// (`%lld`) — `%i`/`%d` expect a promoted C `int` and are ABI-unsafe.

extern "c" {
    fn printf(string fmt, ...) -> int;
}

fn main() {
    printf("hello %lld", 42);
}
