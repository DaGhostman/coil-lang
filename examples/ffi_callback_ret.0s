// examples/ffi_callback_ret.0s — FFI callback/function-pointer return.
//
// get_doubler() returns a C function pointer as an opaque Ptr value.
// Output: the pointer printed as int (non-zero). Re-invoking that
// address as a zero-script callback requires a separate declare/host
// trampoline (not automatic in this phase).

use ffi::*;
use ffi::types::*;

fn main() {
    let lib = dload("libsum.so");
    let id = declare(lib, "get_doubler", (), Ptr);
    let ptr = invoke(lib, id, ());
    // Non-zero pointer address — print low 16 bits as a smoke check
    // that we got a real address back (not -1 / null).
    if ptr == 0 {
        print "%i", 0;
    } else {
        print "%i", 1;
    }
}
