// Test: Generic with type bounds
// Expected: Should compile with bounds

fn with_bound<T: Copy>(T x) -> T {
    return x;
}

fn with_bounds<T: Copy + Clone>(T x) -> T {
    return x;
}

fn main() {
    let a: int = with_bound<int>(42);
    let b: int = with_bounds<int>(100);
    print "%i %i", a, b;
}
